# ScaleVault Environment Configuration
# Copy this file to .env for local environment overrides

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/scalevault
DATABASE_USERNAME=scalevault_user
DATABASE_PASSWORD=scalevault_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Security Configuration
# Must be a 256-bit (32 bytes) hex-encoded or Base64 secret key for HMAC-SHA256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ISSUER=scalevault
ACCESS_TOKEN_TTL=900000          # 15 minutes in milliseconds
REFRESH_TOKEN_TTL=604800000      # 7 days in milliseconds

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
